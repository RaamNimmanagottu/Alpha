ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_MPIN=your_mpin_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# Optional -- if either is missing, Telegram notifications are simply disabled.
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN. For TELEGRAM_CHAT_ID,
# message your bot once then open:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
